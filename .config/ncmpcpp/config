# vim: filetype=conf

ncmpcpp_directory = "~/.config/ncmpcpp"
lyrics_directory = "~/.local/share/lyrics"
mpd_music_dir = "~/Music"
message_delay_time = "1"
visualizer_type = "spectrum"
song_list_format = {$4%a - }{%t}|{$8%f$9}$R{$3(%l)$9}
song_status_format = $b{{$8"%t"}} $3by {$4%a{ $3in $7%b{ (%y)}} $3}|{$8%f}
song_library_format = {%n - }{%t}|{%f}
alternative_header_first_line_format = $b$1$aqqu$/a$9 {%t}|{%f} $1$atqq$/a$9$/b
alternative_header_second_line_format = {{$4$b%a$/b$9}{ - $7%b$9}{ ($4%y$9)}}|{%D}
current_item_prefix = $(154)$r$b
current_item_suffix = $/r$(end)$/b
current_item_inactive_column_prefix = $(112)$r
current_item_inactive_column_suffix = $/r$(end)
playlist_display_mode = columns
browser_display_mode = columns
progressbar_look = ->
media_library_primary_tag = album_artist
media_library_albums_split_by_date = no
startup_screen = "media_library"
display_volume_level = no
ignore_leading_the = yes
external_editor = nvim
use_console_editor = yes
# theme: Nordic blue (256-color, matches dwm palette)
# note: ncmpcpp 256-color values are SGR-1
empty_tag_color = 60
header_window_color = 110
volume_color = 117
state_line_color = 60
state_flags_color = 117
main_window_color = 252
color1 = 110
color2 = 109
progressbar_color = 60
progressbar_elapsed_color = 110:b
statusbar_color = 110
statusbar_time_color = 117:b
player_state_color = 117:b
alternative_ui_separator_color = 60:b
window_border_color = 60
active_window_border = 110
visualizer_color = 110, 111, 117, 153, 189
# execute_on_song_change="pkill -RTMIN+11 dwmblocks"
execute_on_song_change = "~/.config/ncmpcpp/cover_obs.sh"
execute_on_player_state_change="pkill -RTMIN+11 dwmblocks"
