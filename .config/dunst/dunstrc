# ~/.config/dunst/dunstrc
# Nordic Modern Aesthetic — Clean card design with IBM Plex typography
# Matches dwm Nordic theme: #242933 surface, #88c0d0 frost accent, #b48ead rose highlights

[global]
    monitor = 0
    follow = mouse

    ### Geometry & Placement ###
    width = (280, 380)
    height = (60, 200)
    origin = top-right
    offset = (16, 36)
    scale = 0
    notification_limit = 4

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 340
    progress_bar_corner_radius = 3

    ### Spacing & Borders ###
    separator_height = 2
    separator_color = "#3b4252"
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    frame_width = 1
    frame_color = "#4c6a92"
    corner_radius = 8

    ### Typography ###
    # Title in IBM Plex Sans (Medium/Bold) with crisp line spacing
    font = IBM Plex Sans 9
    line_height = 2
    markup = full
    format = "<span font_desc='IBM Plex Sans Bold 9.5' foreground='#88c0d0'>%s</span>\n<span font_desc='IBM Plex Sans 8.5' foreground='#d8dee9'>%b</span>"
    alignment = left
    vertical_alignment = center

    ### Behavior & Content ###
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Tokyonight-Moon, Adwaita
    icon_position = left
    min_icon_size = 20
    max_icon_size = 24
    icon_corner_radius = 0
    icon_corners = all

    ### History & Action Scripts ###
    sticky_history = yes
    history_length = 25
    dmenu = /home/sanj/.local/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    ### Mouse Interactions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# Low Urgency (Info / Background tasks)
[urgency_low]
    background = "#242933C0"
    foreground = "#98a8c0"
    frame_color = "#4c6a92"
    highlight = "#81a1c1"
    timeout = 4
    default_icon = /home/sanj/.config/dunst/icons/bell.svg

# Normal Urgency (Apps, Volume, Media, Notifications)
[urgency_normal]
    background = "#242933C8"
    foreground = "#d8dee9"
    frame_color = "#4c6a92"
    highlight = "#81a1c1"
    timeout = 6
    default_icon = /home/sanj/.config/dunst/icons/bell.svg

# Critical Urgency (Alerts, Low Battery, Errors)
[urgency_critical]
    background = "#2e3440D8"
    foreground = "#eceff4"
    frame_color = "#4c6a92"
    highlight = "#bf616a"
    timeout = 0
    default_icon = /home/sanj/.config/dunst/icons/warning.svg

# Media Player Notifications (Subtle Rose Accent)
[music]
    appname = "ncmpcpp"
    summary = "*"
    background = "#242933C8"
    frame_color = "#4c6a92"
    highlight = "#b48ead"
    default_icon = /home/sanj/.config/dunst/icons/music.svg
    format = "<span font_desc='IBM Plex Sans Bold 9.5' foreground='#88c0d0'>%s</span>\n<span font_desc='IBM Plex Sans 8.5' foreground='#d8dee9'>%b</span>"
    timeout = 5
