#!/bin/sh
# sysact — Modern Frosted Rofi Power & Session Menu

export WM="dwm"
case "$(readlink -f /sbin/init)" in
	*systemd*) ctl='systemctl' ;;
	*) ctl='loginctl' ;;
esac

wmpid(){
	tree="$(pstree -ps $$)"
	tree="${tree#*$WM(}"
	echo "${tree%%)*}"
}

OPTIONS="  Lock Screen
  Suspend / Sleep
  Reboot System
  Power Off
  Log Out of $WM
  Restart $WM"

choice=$(printf "%s\n" "$OPTIONS" | rofi -dmenu -i -p "Power" \
    -theme-str 'window { width: 440px; } listview { columns: 1; lines: 6; scrollbar: false; }' \
    -mesg "Select session action:")

[ -z "$choice" ] && exit 0

case "$choice" in
	*"Lock Screen"*)
		exec lockscreen
		;;
	*"Suspend / Sleep"*)
		lockscreen &
		sleep 0.3
		$ctl suspend -i
		;;
	*"Reboot System"*)
		$ctl reboot -i
		;;
	*"Power Off"*)
		$ctl poweroff -i
		;;
	*"Log Out"*)
		kill -TERM "$(wmpid)"
		;;
	*"Restart"*)
		kill -HUP "$(wmpid)"
		;;
	*)
		exit 1
		;;
esac
