#!/usr/bin/env bash

export NVIM_APPNAME="${NVIM_APPNAME:-"nvoid"}"

export NVOID_RUNTIME_DIR="${NVOID_RUNTIME_DIR:-$HOME/.local/share/nvoid}"
export NVOID_CONFIG_DIR="${NVOID_CONFIG_DIR:-$HOME/.config/nvoid}"
export NVOID_CACHE_DIR="${NVOID_CACHE_DIR:-$HOME/.cache/nvoid}"

export NVOID_BASE_DIR="${NVOID_BASE_DIR:-$HOME/.local/share/nvoid/nvoid}"

exec -a "$NVIM_APPNAME" nvim -u "$NVOID_BASE_DIR/init.lua" "$@"
