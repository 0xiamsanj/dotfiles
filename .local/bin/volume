#!/bin/sh

# Prints the current volume, 󰝟 if muted, and caps display at 100%.

case $BLOCK_BUTTON in
	1) setsid -f alacritty --class floatterm -T "pulsemixer" -o "window.dimensions.columns=72" -o "window.dimensions.lines=20" -e pulsemixer >/dev/null 2>&1 ;;
	2) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;  # middle click mutes
	4) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ ;;   # scroll up louder
	5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- ;;   # scroll down quieter
	3) notify-send "Volume Module" "Left click: pulsemixer\nMiddle click: mute\nScroll: adjust volume" ;;
esac

vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"

# If muted, print 󰝟 and exit.
[ "$vol" != "${vol%\[MUTED\]}" ] && echo 󰝟 && exit

vol="${vol#Volume: }"

split() {
	# For ommiting the . without calling and external program.
	IFS=$2
	set -- $1
	printf '%s' "$@"
}

vol="$(printf "%.0f" "$(split "$vol" ".")")"

# Cap displayed volume at 100% (waterpctl can go higher than 100%).
[ "$vol" -gt 100 ] && vol=100

case 1 in
	$((vol >= 70)) ) icon=" " ;;
	$((vol >= 30)) ) icon="" ;;
	$((vol >= 1)) ) icon="" ;;
	* ) echo 󰝟 && exit ;;
esac

echo "$icon $vol%"
