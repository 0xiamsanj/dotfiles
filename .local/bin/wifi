#!/bin/sh

# Shows the wifi for the default interface; click opens nmtui.

case $BLOCK_BUTTON in
	1) setsid -f alacritty --class floatterm -T "nmtui" -o "window.dimensions.columns=70" -o "window.dimensions.lines=24" -e nmtui >/dev/null 2>&1 ;;
	3) setsid -f alacritty --class floatterm -T "nmtui" -o "window.dimensions.columns=70" -o "window.dimensions.lines=24" -e nmtui >/dev/null 2>&1 ;;
esac

# Function to get the network status
get_network_status() {
    # Get the default network interface
    default_interface=$(ip route | awk '/default/ { print $5 }')

    # Check if the default interface is Wi-Fi or Ethernet
    if [ "$(cat /sys/class/net/${default_interface}/operstate 2>/dev/null)" == "up" ]; then
        if [ "$(cat /sys/class/net/${default_interface}/carrier 2>/dev/null)" == "1" ]; then
            # Get the SSID of the Wi-Fi network
            ssid=$(iwgetid -r)
            if [ -n "$ssid" ]; then
                short=$(printf '%s' "$ssid" | cut -c1-10)
                [ "${#ssid}" -gt 10 ] && short="${short}…"
                echo "  $short"
            else
                echo "  Connected"
            fi
        else
            echo "  Ethernet"
        fi
    else
        echo "󰖭 Oops"
    fi
}

# Display the network status
echo "  $(get_network_status)"
