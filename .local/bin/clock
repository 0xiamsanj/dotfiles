#!/bin/sh

# Clock block: shows the hour icon + time; click shows the month calendar.

case $BLOCK_BUTTON in
	1) notify-send "Today" "$(date '+%A %d %B %Y')" && notify-send "This Month" "$(cal | sed "s/\<$(date +'%e')\>/<b><span color='#a1baf0'>&<\/span><\/b>/")" ;;
	3) notify-send " Clock module" "Left click: month calendar" ;;
esac

clock=$(date +%H)

case "$clock" in
	"00") icon="󱑊" ;;
	"01") icon="󱐿" ;;
	"02") icon="󱑀" ;;
	"03") icon="󱑁" ;;
	"04") icon="󱑂" ;;
	"05") icon="󱑃" ;;
	"06") icon="󱑄" ;;
	"07") icon="󱑅" ;;
	"08") icon="󱑆" ;;
	"09") icon="󱑇" ;;
	"10") icon="󱑈" ;;
	"11") icon="󱑉" ;;
	"12") icon="󱑊" ;;
	"13") icon="󱐿" ;;
	"14") icon="󱑀" ;;
	"15") icon="󱑁" ;;
	"16") icon="󱑂" ;;
	"17") icon="󱑃" ;;
	"18") icon="󱑄" ;;
	"19") icon="󱑅" ;;
	"20") icon="󱑆" ;;
	"21") icon="󱑇" ;;
	"22") icon="󱑈" ;;
	"23") icon="󱑉" ;;
esac

date "+  %b-%d  $icon %H:%M"
