#!/bin/sh
# music — statusbar module for MPD (ncmpcpp) & Spotify / MPRIS
# Updates dwmblocks with current playing or paused song.

# Handle click actions on dwmblocks (Update Signal = 11)
case "$BLOCK_BUTTON" in
	1)
		# Left click: Toggle play/pause
		if [ -n "$(playerctl -l 2>/dev/null)" ]; then
			playerctl play-pause 2>/dev/null
		else
			mpc toggle >/dev/null 2>&1
		fi
		pkill -RTMIN+11 dwmblocks 2>/dev/null
		;;
	2)
		# Middle click: Open ncmpcpp in terminal
		setsid -f alacritty -e ncmpcpp >/dev/null 2>&1
		;;
	3)
		# Right click: Next track
		if [ -n "$(playerctl -l 2>/dev/null)" ]; then
			playerctl next 2>/dev/null
		else
			mpc next >/dev/null 2>&1
		fi
		pkill -RTMIN+11 dwmblocks 2>/dev/null
		;;
	4)
		# Scroll up: Prev track
		if [ -n "$(playerctl -l 2>/dev/null)" ]; then
			playerctl previous 2>/dev/null
		else
			mpc prev >/dev/null 2>&1
		fi
		pkill -RTMIN+11 dwmblocks 2>/dev/null
		;;
	5)
		# Scroll down: Next track
		if [ -n "$(playerctl -l 2>/dev/null)" ]; then
			playerctl next 2>/dev/null
		else
			mpc next >/dev/null 2>&1
		fi
		pkill -RTMIN+11 dwmblocks 2>/dev/null
		;;
esac

# 1. First check Spotify / MPRIS playerctl players
mpris_player=""
for p in $(playerctl -l 2>/dev/null); do
	case "$p" in
		spotify*) mpris_player="$p"; break ;;
		*) [ -z "$mpris_player" ] && mpris_player="$p" ;;
	esac
done

if [ -n "$mpris_player" ]; then
	status=$(playerctl --player="$mpris_player" status 2>/dev/null)
	if [ "$status" = "Playing" ] || [ "$status" = "Paused" ]; then
		artist=$(playerctl --player="$mpris_player" metadata artist 2>/dev/null)
		title=$(playerctl --player="$mpris_player" metadata title 2>/dev/null)
		[ -z "$title" ] && title=$(playerctl --player="$mpris_player" metadata xesam:title 2>/dev/null)
		
		if [ -n "$title" ]; then
			if [ ${#title} -gt 25 ]; then
				title="$(echo "$title" | cut -c 1-22)..."
			fi
			if [ -n "$artist" ]; then
				if [ ${#artist} -gt 18 ]; then
					artist="$(echo "$artist" | cut -c 1-15)..."
				fi
				text="$artist - $title"
			else
				text="$title"
			fi
			
			if [ "$status" = "Playing" ]; then
				printf " %s\n" "$text"
			else
				printf " 󰏤 %s\n" "$text"
			fi
			exit 0
		fi
	fi
fi

# 2. Check MPD via mpc
mpd_raw=$(mpc status 2>/dev/null)
if [ -n "$mpd_raw" ]; then
	# If paused or playing
	if echo "$mpd_raw" | grep -q '\[playing\]'; then
		song=$(echo "$mpd_raw" | head -n 1)
		# Truncate if too long
		if [ ${#song} -gt 35 ]; then
			song="$(echo "$song" | cut -c 1-32)..."
		fi
		printf " %s\n" "$song"
		exit 0
	elif echo "$mpd_raw" | grep -q '\[paused\]'; then
		song=$(echo "$mpd_raw" | head -n 1)
		if [ ${#song} -gt 35 ]; then
			song="$(echo "$song" | cut -c 1-32)..."
		fi
		printf " 󰏤 %s\n" "$song"
		exit 0
	fi
fi

exit 0
