#!/bin/sh
# battery — Interactive battery block and detailed notification card

BAT="/sys/class/power_supply/BAT1"
[ ! -d "$BAT" ] && BAT="$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n 1)"

if [ ! -d "$BAT" ]; then
    echo "󰂎 No Bat"
    exit 0
fi

status="$(cat "$BAT/status" 2>/dev/null)"
capacity="$(cat "$BAT/capacity" 2>/dev/null)"
[ -z "$capacity" ] && capacity=0

# On click: detailed battery health card notification
case $BLOCK_BUTTON in
    1|3)
        energy_now=$(cat "$BAT/energy_now" 2>/dev/null || cat "$BAT/charge_now" 2>/dev/null || echo 0)
        energy_full=$(cat "$BAT/energy_full" 2>/dev/null || cat "$BAT/charge_full" 2>/dev/null || echo 0)
        energy_design=$(cat "$BAT/energy_full_design" 2>/dev/null || cat "$BAT/charge_full_design" 2>/dev/null || echo 0)
        power_now=$(cat "$BAT/power_now" 2>/dev/null || cat "$BAT/current_now" 2>/dev/null || echo 0)

        health="Unknown"
        if [ "$energy_full" -gt 0 ] && [ "$energy_design" -gt 0 ]; then
            health="$(( (energy_full * 100) / energy_design ))%"
        fi

        rate_w="N/A"
        if [ "$power_now" -gt 0 ]; then
            rate_w="$(awk -v p="$power_now" 'BEGIN { printf "%.2f W", p / 1000000 }')"
        fi

        notify-send -u normal "Battery Details" "Status: $status ($capacity%)\nHealth: $health\nRate: $rate_w\nPower Profile: Balanced" -i battery
        ;;
esac

# Glyphs
case "$status" in
    "Full") icon="󰂅" ;;
    "Charging") icon="󰂄" ;;
    "Discharging")
        if [ "$capacity" -ge 90 ]; then icon="󰁹"
        elif [ "$capacity" -ge 70 ]; then icon="󰂁"
        elif [ "$capacity" -ge 50 ]; then icon="󰁿"
        elif [ "$capacity" -ge 30 ]; then icon="󰁽"
        elif [ "$capacity" -ge 15 ]; then icon="󰁻"
        else icon="󰂃"
        fi
        ;;
    *) icon="󰁹" ;;
esac

echo "$icon $capacity%"
