#!/bin/sh

# Time block (hour icon + clock). Click shows today's date.

case $BLOCK_BUTTON in

	1) notify-send "Today" "$(date '+%A %d %B %Y')" ;;

	3) notify-send " Time module" "Left click: today's date" ;;

esac


hour=$(date +%H)


case "$hour" in

	"00") icon="󱑊" ;;

	"01") icon="󱐿" ;;

	"02") icon="󱑀" ;;

	"03") icon="󱑁" ;;

	"04") icon="󱑂" ;;

	"05") icon="󱑃" ;;

	"06") icon="󱑄" ;;

	"07") icon="󱑅" ;;

	"08") icon="󱑆" ;;

	"09") icon="󱑇" ;;

	"10") icon="󱑈" ;;

	"11") icon="󱑉" ;;

	"12") icon="󱑊" ;;

	"13") icon="󱐿" ;;

	"14") icon="󱑀" ;;

	"15") icon="󱑁" ;;

	"16") icon="󱑂" ;;

	"17") icon="󱑃" ;;

	"18") icon="󱑄" ;;

	"19") icon="󱑅" ;;

	"20") icon="󱑆" ;;

	"21") icon="󱑇" ;;

	"22") icon="󱑈" ;;

	"23") icon="󱑉" ;;

esac


date "+$icon %H:%M  "
